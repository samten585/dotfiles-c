"./dist/web/extension.js","contributes":{"configuration":{"title":"Better YAML","properties":{"better-yaml.indentSeq":{"type":"boolean","default":false,"description":"Whether block sequences should be indented."},"better-yaml.directives":{"type":["boolean","null"],"default":null,"description":"Include directives in the output. If true, at least the document-start marker --- is always included. If false, no directives or marker is ever included. If null, directives and marker may be included if required."},"better-yaml.commentString":{"type":["string","null"],"default":null,"description":"Output should be valid for the current schema. By default, empty comment lines are left empty, lines consisting of a single space are replaced by #, and all other lines are prefixed with a #."},"better-yaml.lineWidth":{"type":["number"],"default":0,"description":"Maximum line width (set to 0 to disable folding). This is a soft limit, as only double-quoted semantics allow for inserting a line break in the middle of a word."},"better-yaml.flowCollectionPadding":{"type":["boolean"],"default":true,"description":"When true, a single space of padding will be added inside the delimiters of non-empty single-line flow collections."},"better-yaml.documentOptions.version":{"type":["string"],"default":"1.2","description":"The YAML version used by documents without a %YAML directive. Must be '1.1' or '1.2'."}}},"configurationDefaults":{"[yaml]":{"editor.defaultFormatter":"joseph-ravenwolfe.kubernetes-yaml-formatter","editor.formatOnSave":true},"[helm]":{"editor.defaultFormatter":"joseph-ravenwolfe.kubernetes-yaml-formatter","editor.formatOnSave":false},"[ansible]":{"editor.defaultFormatter":"joseph-ravenwolfe.kubernetes-yaml-formatter","editor.formatOnSave":false}}},"scripts":{"vscode:prepublish":"npm run compile && npm run compile-web","compile":"tsc -p ./","compile-web":"webpack","watch":"tsc -watch -p ./","watch-web":"webpack --watch","pretest":"npm run compile && npm run lint","lint":"eslint