#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias grep='grep --color=auto'
#PS1='\u@\h \W\$ '
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$\n\[\e[1;36m\]➜ '

export QT_QPA_PLATFORMTHEME=qt6ct

export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24

export EDITOR=nvim
export PATH=$PATH:~/.local/bin/

eval "$(ssh-agent -s)"
ssh-add ~/.ssh/gethub


alias c='clear'
alias ls='eza -a --color=auto --icons=always'
alias ll='eza -al --color=auto --icons=always'
alias lt='eza -a --tree --level=1 --color=auto --icons=always'
alias v='$EDITOR'
alias vim='$EDITOR'
